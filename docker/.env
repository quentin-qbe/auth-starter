# ============================================================
# Spring application
# ============================================================
SPRING_APPLICATION_NAME=authstarter

# ============================================================
# JWT
# ============================================================
JWT_ISSUER=http://localhost:8081/authstarter
JWT_AUDIENCE=springstarter-api
JWT_ACCESS_TOKEN_DURATION=3600s
JWT_REFRESH_TOKEN_DURATION=30d

# ============================================================
# RSA keys
# ============================================================
RSA_PRIVATE_KEY=classpath:certs/private-key.pem
RSA_PUBLIC_KEY=classpath:certs/public-key.pem

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_CONTAINER_NAME=authstarter-postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ============================================================
# Spring datasource
# ============================================================
# "postgres" correspond au nom du service Docker Compose.
# Depuis le conteneur app, il ne faut pas utiliser localhost.

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_SCHEMA=authdb

# ============================================================
# Application / Server
# ============================================================
APP_CONTAINER_NAME=authstarter
APP_PORT=8081
SERVER_PORT=8081
SERVER_CONTEXT_PATH=/authstarter

# ============================================================
# Liquibase
# ============================================================
LIQUIBASE_IMAGE=liquibase/liquibase:latest

# ============================================================
# Logging
# ============================================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SECURITY=INFO